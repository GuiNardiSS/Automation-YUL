{
  "name": "pncp-audiovisual-tender-monitor",
  "version": "1.0.0",
  "description": "Monitors PNCP for audiovisual-related tenders in SC/PR/RS and emails alerts.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-api": "tsx scripts/verify-api.ts",
    "send-test-email": "tsx scripts/send-test-email.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ioredis": "^5.4.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.14",
    "undici": "^8.10.0",
    "winston": "^3.13.1",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.15",
    "ioredis-mock": "^8.9.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  }
}
